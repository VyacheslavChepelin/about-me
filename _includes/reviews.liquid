{% comment %}
  Reviews from _reviews/ collection.
  Plain markup — no Bootstrap row/col (they overflow inside .post).
{% endcomment %}

{% assign all_reviews = site.reviews | where_exp: "r", "r.name != nil and r.name != ''" | sort: "order" %}
{% assign featured_reviews = all_reviews | where: "featured", true %}
{% assign secondary_reviews = all_reviews | where: "featured", false %}

{% if featured_reviews.size > 0 %}
<div class="reviews-list">
  {% for review in featured_reviews %}
  <div class="review-card">
    <p class="review-quote">«{{ review.content | strip_html | strip }}»</p>
    <p class="review-author mb-0">
      <strong>{{ review.name }}</strong>{% if review.role %} — {{ review.role }}{% endif %}
      {% if review.subject or review.result %}
      <br>
      <span class="review-meta">
        {% if review.subject %}<span class="review-chip">{{ review.subject }}</span>{% endif %}
        {% if review.result %}<span class="review-chip review-chip-result">{{ review.result }}</span>{% endif %}
      </span>
      {% endif %}
    </p>
  </div>
  {% endfor %}
</div>
{% endif %}

{% if secondary_reviews.size > 0 %}
<details class="reviews-more mt-3">
  <summary>Ещё отзывы ({{ secondary_reviews.size }})</summary>
  <div class="reviews-list mt-3">
    {% for review in secondary_reviews %}
    <div class="review-card review-card-secondary">
      <p class="review-quote">«{{ review.content | strip_html | strip }}»</p>
      <p class="review-author mb-0">
        <strong>{{ review.name }}</strong>{% if review.role %} — {{ review.role }}{% endif %}
        {% if review.result %} · {{ review.result }}{% endif %}
      </p>
    </div>
    {% endfor %}
  </div>
</details>
{% endif %}

{% if all_reviews.size == 0 %}
<p class="text-muted">Отзывы скоро появятся.</p>
{% endif %}
